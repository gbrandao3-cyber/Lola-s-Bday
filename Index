<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lola's 4th Bday</title>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    background: #0099cc;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Nunito', sans-serif;
    padding: 20px;
    overflow-x: hidden;
  }

  /* Ocean + sky bg */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      linear-gradient(180deg,
        #87CEEB 0%,
        #b0e0ff 35%,
        #40b4e5 55%,
        #0077aa 70%,
        #005f8a 100%
      );
    z-index: -2;
  }

  /* Animated sun rays */
  .sun {
    position: fixed;
    top: -60px;
    right: 60px;
    width: 140px;
    height: 140px;
    z-index: -1;
    pointer-events: none;
  }

  .sun-circle {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 70px; height: 70px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF176, #FFD700);
    box-shadow: 0 0 40px 15px rgba(255,220,50,0.5);
    animation: sunPulse 3s ease-in-out infinite;
  }

  @keyframes sunPulse {
    0%, 100% { box-shadow: 0 0 40px 15px rgba(255,220,50,0.5); }
    50% { box-shadow: 0 0 60px 25px rgba(255,220,50,0.7); }
  }

  .sun-ray {
    position: absolute;
    top: 50%; left: 50%;
    width: 50px; height: 6px;
    background: linear-gradient(90deg, rgba(255,220,50,0.7), transparent);
    border-radius: 3px;
    transform-origin: 0 50%;
    animation: spinRays 8s linear infinite;
  }

  @keyframes spinRays { from { rotate: 0deg; } to { rotate: 360deg; } }

  /* Wave animation */
  .waves-bg {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .wave {
    position: absolute;
    bottom: 0;
    left: -50%;
    width: 200%;
    height: 80px;
    background: rgba(255,255,255,0.15);
    border-radius: 50% 50% 0 0 / 20px 20px 0 0;
    animation: waveMove var(--wdur, 6s) var(--wdelay,0s) ease-in-out infinite alternate;
  }

  @keyframes waveMove {
    from { transform: translateX(-5%); }
    to { transform: translateX(5%); }
  }

  .sparkles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .sparkle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
    opacity: 0;
    animation: twinkle var(--dur, 3s) var(--delay, 0s) infinite ease-in-out;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    50% { opacity: 0.9; transform: scale(1.2); }
  }

  /* Card */
  .card {
    background: linear-gradient(160deg, #fff9f0 0%, #fff0f9 40%, #f0faff 100%);
    border-radius: 32px;
    max-width: 480px;
    width: 100%;
    padding: 0;
    overflow: hidden;
    box-shadow:
      0 0 0 4px #ff69b4,
      0 0 0 8px #00aadd,
      0 20px 80px rgba(0, 170, 220, 0.4),
      0 40px 120px rgba(255, 105, 180, 0.3);
    position: relative;
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }

  /* Top banner */
  .top-banner {
    background: linear-gradient(135deg, #00aadd, #ff69b4, #ff1493, #00ccaa);
    background-size: 300% 300%;
    animation: shimmer 4s ease infinite;
    padding: 28px 24px 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .top-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255,255,255,0.06) 10px,
      rgba(255,255,255,0.06) 20px
    );
  }

  @keyframes shimmer {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .you-are-invited {
    font-family: 'Pacifico', cursive;
    font-size: 13px;
    color: rgba(255,255,255,0.85);
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 6px;
    animation: fadeDown 0.8s ease both;
  }

  .big-title {
    font-family: 'Pacifico', cursive;
    font-size: 52px;
    color: #fff;
    line-height: 1;
    text-shadow:
      3px 3px 0 #c20068,
      0 0 30px rgba(255,255,255,0.5);
    animation: fadeDown 0.8s 0.1s ease both;
    margin-bottom: 4px;
  }

  .title-party {
    font-family: 'Pacifico', cursive;
    font-size: 28px;
    color: #fff0f9;
    text-shadow: 2px 2px 0 #c20068;
    animation: fadeDown 0.8s 0.2s ease both;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Doll silhouette area */
  .doll-section {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    margin-top: -10px;
    padding: 0 16px;
    position: relative;
  }

  .doll-svg {
    width: 140px;
    filter: drop-shadow(0 4px 20px rgba(255,20,147,0.4));
    animation: dollBounce 3s ease-in-out infinite;
  }

  @keyframes dollBounce {
    0%, 100% { transform: rotate(-2deg) scale(1); }
    50% { transform: rotate(2deg) scale(1.03); }
  }

  /* Stars row */
  .stars-row {
    text-align: center;
    font-size: 20px;
    letter-spacing: 6px;
    margin: 8px 0 4px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  /* Name badge */
  .name-badge {
    margin: 4px 24px 0;
    background: linear-gradient(135deg, #ff1493, #ff69b4);
    border-radius: 50px;
    padding: 14px 20px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(255,20,147,0.35);
    position: relative;
    overflow: hidden;
  }

  .name-badge::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    animation: shine 2.5s ease infinite;
  }

  @keyframes shine {
    from { left: -100%; }
    to { left: 200%; }
  }

  .name-label {
    font-size: 11px;
    color: rgba(255,255,255,0.8);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 3px;
  }

  .name-text {
    font-family: 'Pacifico', cursive;
    font-size: 30px;
    color: #fff;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.15);
  }

  .age-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: #ff1493;
    font-family: 'Pacifico', cursive;
    font-size: 22px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    margin-top: 8px;
    box-shadow: 0 2px 12px rgba(255,20,147,0.3);
    border: 3px solid #ff69b4;
  }

  /* Details section */
  .details {
    padding: 20px 28px 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: rgba(255,255,255,0.65);
    border-radius: 16px;
    padding: 12px 16px;
    border: 1.5px solid rgba(255,105,180,0.25);
    animation: slideIn 0.6s ease both;
  }

  .detail-row:nth-child(1) { animation-delay: 0.3s; }
  .detail-row:nth-child(2) { animation-delay: 0.45s; }
  .detail-row:nth-child(3) { animation-delay: 0.6s; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .detail-icon {
    font-size: 26px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .detail-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #ff69b4;
    font-weight: 800;
    display: block;
    margin-bottom: 2px;
  }

  .detail-value {
    font-size: 16px;
    color: #5a003a;
    font-weight: 700;
    line-height: 1.3;
  }

  /* RSVP */
  .rsvp-section {
    margin: 8px 24px 24px;
    background: linear-gradient(135deg, #fff0f5, #ffe0ef);
    border-radius: 20px;
    padding: 16px 20px;
    text-align: center;
    border: 2px dashed #ff69b4;
    animation: slideIn 0.6s 0.75s ease both;
  }

  .rsvp-title {
    font-family: 'Pacifico', cursive;
    font-size: 16px;
    color: #ff1493;
    margin-bottom: 4px;
  }

  .rsvp-text {
    font-size: 13px;
    color: #8b0050;
    font-weight: 600;
    line-height: 1.5;
  }

  /* Bottom bow decoration */
  .bow-row {
    text-align: center;
    font-size: 28px;
    letter-spacing: 8px;
    padding: 0 0 20px;
    opacity: 0.7;
  }

  /* Floating hearts */
  .hearts {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .heart {
    position: absolute;
    bottom: -30px;
    font-size: var(--size, 18px);
    opacity: 0;
    animation: riseHeart var(--rise, 6s) var(--hdelay, 0s) infinite ease-in;
  }

  @keyframes riseHeart {
    0% { bottom: -30px; opacity: 0.8; transform: translateX(0) rotate(0deg); }
    50% { opacity: 0.5; transform: translateX(20px) rotate(15deg); }
    100% { bottom: 110vh; opacity: 0; transform: translateX(-20px) rotate(-15deg); }
  }
</style>
</head>
