      <div class="detail-icon">🌺</div>
      <div>
        <span class="detail-label">Dress Code</span>
        <div class="detail-value">Come in your best beach & aloha Barbie look!</div>
      </div>
    </div>
  </div>

  <div class="rsvp-section" id="rsvpBtn" onclick="openRsvp()" style="cursor:pointer; transition: transform 0.15s, box-shadow 0.15s;" onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='0 8px 30px rgba(255,20,147,0.4)'" onmouseleave="this.style.transform='scale(1)';this.style.boxShadow=''">
    <div class="rsvp-title">💌 RSVP</div>
    <div class="rsvp-text">Tap here to let us know you're coming! 🎉</div>
    <div style="margin-top:8px; display:inline-block; background:#ff1493; color:#fff; font-family:'Nunito',sans-serif; font-weight:800; font-size:13px; padding:6px 20px; border-radius:50px; letter-spacing:1px;">TAP TO RSVP →</div>
  </div>

  <!-- RSVP Modal -->
  <div id="rsvpModal" style="display:none; position:fixed; inset:0; z-index:1000; align-items:center; justify-content:center; padding:20px;">
    <div onclick="closeRsvp()" style="position:absolute; inset:0; background:rgba(0,0,0,0.45); backdrop-filter:blur(4px);"></div>
    <div id="rsvpPanel" style="position:relative; background:linear-gradient(160deg,#fff9f0,#fff0f9); border-radius:28px; padding:30px 28px 28px; max-width:360px; width:100%; box-shadow:0 0 0 4px #ff69b4, 0 20px 60px rgba(255,20,147,0.35); text-align:center; animation: popIn 0.3s ease both;">
      <div id="rsvpStep1">
        <div style="font-family:'Pacifico',cursive; font-size:22px; color:#ff1493; margin-bottom:6px;">Are you coming? 🌺</div>
        <div style="font-size:13px; color:#8b0050; font-weight:600; margin-bottom:22px;">Lola's 4th Barbie Hawaii Party</div>
        <div style="display:flex; gap:14px; justify-content:center;">
          <button onclick="chooseYes()" style="flex:1; background:linear-gradient(135deg,#ff1493,#ff69b4); color:#fff; border:none; border-radius:16px; padding:18px 10px; font-family:'Nunito',sans-serif; font-weight:800; font-size:18px; cursor:pointer; box-shadow:0 4px 20px rgba(255,20,147,0.35); transition:transform 0.15s;" onmouseenter="this.style.transform='scale(1.05)'" onmouseleave="this.style.transform='scale(1)'">
            🎉 Yes!
          </button>
          <button onclick="chooseNo()" style="flex:1; background:linear-gradient(135deg,#e0e0e0,#bdbdbd); color:#555; border:none; border-radius:16px; padding:18px 10px; font-family:'Nunito',sans-serif; font-weight:800; font-size:18px; cursor:pointer; box-shadow:0 4px 16px rgba(0,0,0,0.1); transition:transform 0.15s;" onmouseenter="this.style.transform='scale(1.05)'" onmouseleave="this.style.transform='scale(1)'">
            😢 Can't make it
          </button>
        </div>
      </div>

      <div id="rsvpStep2" style="display:none;">
        <div style="font-size:36px; margin-bottom:8px;">🌺🎉🌺</div>
        <div style="font-family:'Pacifico',cursive; font-size:20px; color:#ff1493; margin-bottom:6px;">Yay! How many guests?</div>
        <div style="font-size:13px; color:#8b0050; font-weight:600; margin-bottom:16px;">Including yourself</div>
        <div style="display:flex; align-items:center; justify-content:center; gap:20px; margin-bottom:20px;">
          <button onclick="changeCount(-1)" style="width:44px; height:44px; border-radius:50%; border:none; background:#ff69b4; color:#fff; font-size:22px; font-weight:900; cursor:pointer; box-shadow:0 3px 12px rgba(255,105,180,0.4); line-height:1; transition:transform 0.1s;" onmouseenter="this.style.transform='scale(1.1)'" onmouseleave="this.style.transform='scale(1)'">−</button>
          <div style="text-align:center;">
            <div id="guestCount" style="font-family:'Pacifico',cursive; font-size:52px; color:#ff1493; line-height:1; min-width:60px;">1</div>
            <div style="font-size:12px; color:#cc6699; font-weight:700; letter-spacing:1px; text-transform:uppercase;" id="guestLabel">guest</div>
          </div>
          <button onclick="changeCount(1)" style="width:44px; height:44px; border-radius:50%; border:none; background:#ff69b4; color:#fff; font-size:22px; font-weight:900; cursor:pointer; box-shadow:0 3px 12px rgba(255,105,180,0.4); line-height:1; transition:transform 0.1s;" onmouseenter="this.style.transform='scale(1.1)'" onmouseleave="this.style.transform='scale(1)'">+</button>
        </div>
        <input id="guestName" type="text" placeholder="Your name" style="width:100%; padding:12px 16px; border-radius:50px; border:2px solid #ff69b4; font-family:'Nunito',sans-serif; font-size:15px; font-weight:700; color:#5a003a; outline:none; margin-bottom:14px; text-align:center; background:#fff0f9;" />
        <button onclick="submitRsvp()" style="width:100%; background:linear-gradient(135deg,#ff1493,#ff69b4); color:#fff; border:none; border-radius:50px; padding:14px; font-family:'Nunito',sans-serif; font-weight:800; font-size:16px; cursor:pointer; box-shadow:0 4px 20px rgba(255,20,147,0.35); letter-spacing:0.5px; transition:transform 0.15s;" onmouseenter="this.style.transform='scale(1.03)'" onmouseleave="this.style.transform='scale(1)'">Confirm 🎊</button>
      </div>

      <div id="rsvpStep3" style="display:none;">
        <div style="font-size:48px; margin-bottom:10px; animation: popIn 0.4s ease both;">🎉</div>
        <div style="font-family:'Pacifico',cursive; font-size:22px; color:#ff1493; margin-bottom:8px;">We'll see you there!</div>
        <div id="confirmMsg" style="font-size:14px; color:#8b0050; font-weight:600; line-height:1.5; margin-bottom:20px;"></div>
        <button onclick="closeRsvp()" style="background:linear-gradient(135deg,#ff1493,#ff69b4); color:#fff; border:none; border-radius:50px; padding:12px 30px; font-family:'Nunito',sans-serif; font-weight:800; font-size:14px; cursor:pointer; box-shadow:0 4px 16px rgba(255,20,147,0.3);">Close 🌺</button>
      </div>

      <div id="rsvpStep4" style="display:none;">
        <div style="font-size:48px; margin-bottom:10px;">😢</div>
        <div style="font-family:'Pacifico',cursive; font-size:20px; color:#888; margin-bottom:8px;">We'll miss you!</div>
        <div style="font-size:13px; color:#999; font-weight:600; margin-bottom:20px;">Thanks for letting us know. We hope to celebrate with you another time! 💕</div>
        <button onclick="closeRsvp()" style="background:linear-gradient(135deg,#bbb,#999); color:#fff; border:none; border-radius:50px; padding:12px 30px; font-family:'Nunito',sans-serif; font-weight:800; font-size:14px; cursor:pointer;">Close</button>
      </div>

      <button onclick="closeRsvp()" style="position:absolute; top:14px; right:16px; background:none; border:none; font-size:20px; cursor:pointer; color:#cc6699; font-weight:900; line-height:1;">✕</button>
    </div>
  </div>

  <div class="bow-row">🌺 🌊 🐚 🌊 🌺</div>
</div>

<!-- Sun -->
<div class="sun">
  <div class="sun-circle"></div>
  <div class="sun-ray" style="rotate:0deg"></div>
  <div class="sun-ray" style="rotate:45deg"></div>
  <div class="sun-ray" style="rotate:90deg"></div>
  <div class="sun-ray" style="rotate:135deg"></div>
  <div class="sun-ray" style="rotate:180deg"></div>
  <div class="sun-ray" style="rotate:225deg"></div>
  <div class="sun-ray" style="rotate:270deg"></div>
  <div class="sun-ray" style="rotate:315deg"></div>
</div>

<!-- Waves -->
<div class="waves-bg">
  <div class="wave" style="--wdur:5s; --wdelay:0s; opacity:0.7;"></div>
  <div class="wave" style="--wdur:7s; --wdelay:1s; opacity:0.5; height:60px;"></div>
  <div class="wave" style="--wdur:9s; --wdelay:2s; opacity:0.3; height:45px;"></div>
</div>

<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbz5O98FUEpRdC57Fk6sg2J4BqdVsXaCrLEBDoWPg5rbRV2Iulgtpswzt7sQr68BDMA/exec';

  let guestCount = 1;

  function openRsvp() {
    const m = document.getElementById('rsvpModal');
    m.style.display = 'flex';
    showStep('rsvpStep1');
  }

  function closeRsvp() {
    document.getElementById('rsvpModal').style.display = 'none';
    guestCount = 1;
    document.getElementById('guestCount').textContent = '1';
    document.getElementById('guestLabel').textContent = 'guest';
    document.getElementById('guestName').value = '';
    showStep('rsvpStep1');
  }

  function showStep(id) {
    ['rsvpStep1','rsvpStep2','rsvpStep3','rsvpStep4'].forEach(s => {
      document.getElementById(s).style.display = s === id ? 'block' : 'none';
    });
  }

  function chooseYes() { showStep('rsvpStep2'); }
  function chooseNo() {
    submitToGoogle('No', 0, 'N/A');
    showStep('rsvpStep4');
  }

  function changeCount(delta) {
    guestCount = Math.max(1, Math.min(20, guestCount + delta));
    document.getElementById('guestCount').textContent = guestCount;
    document.getElementById('guestLabel').textContent = guestCount === 1 ? 'guest' : 'guests';
  }

  function submitRsvp() {
    const name = document.getElementById('guestName').value.trim() || 'Anonymous';
    submitToGoogle('Yes', guestCount, name);
    document.getElementById('confirmMsg').textContent =
      `${name}, you're bringing ${guestCount} ${guestCount === 1 ? 'guest' : 'guests'} — we can't wait to celebrate with you! 🌺🎊`;
    showStep('rsvpStep3');
  }

  function submitToGoogle(attending, guests, name) {
    fetch(SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, attending, guests })
    }).catch(() => {});
  }

  // Generate sparkles
  const sparklesEl = document.getElementById('sparkles');
  for (let i = 0; i < 60; i++) {
    const s = document.createElement('div');
    s.className = 'sparkle';
    s.style.cssText = `
      left: ${Math.random()*100}%;
      top: ${Math.random()*100}%;
      --dur: ${2 + Math.random()*3}s;
      --delay: ${Math.random()*4}s;
      width: ${3 + Math.random()*5}px;
      height: ${3 + Math.random()*5}px;
      background: ${Math.random() > 0.5 ? 'white' : '#FFD700'};
    `;
    sparklesEl.appendChild(s);
  }

  // Floating hearts
  const heartsEl = document.getElementById('hearts');
  const emojis = ['🌺','🌊','⭐','🐚','💖','🌸','✨','🏄'];
  for (let i = 0; i < 14; i++) {
    const h = document.createElement('div');
    h.className = 'heart';
    h.textContent = emojis[Math.floor(Math.random()*emojis.length)];
    h.style.cssText = `
      left: ${Math.random()*100}%;
      --size: ${14 + Math.random()*16}px;
      --rise: ${5 + Math.random()*6}s;
      --hdelay: ${Math.random()*6}s;
    `;
    heartsEl.appendChild(h);
  }
</script>
</body>
</html>
